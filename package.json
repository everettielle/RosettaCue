{
  "name": "rosettacue",
  "private": true,
  "version": "0.1.0",
  "description": "Turn Blu-ray image subtitles into verifiable text.",
  "main": "dist-electron/main.js",
  "packageManager": "pnpm@11.20.0",
  "type": "module",
  "scripts": {
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations --strategy baseLocale --silent",
    "dev": "cargo build -p rosettacue-backend && vite",
    "dev:web": "vite --mode web",
    "build": "pnpm i18n:compile && cargo build --release -p rosettacue-backend && tsc -b && vite build",
    "build:backend": "cargo build --release -p rosettacue-backend",
    "build:backend:dev": "cargo build -p rosettacue-backend",
    "build:desktop": "pnpm i18n:compile && tsc -b && vite build",
    "package": "pnpm i18n:compile && cargo build --release -p rosettacue-backend && tsc -b && vite build && electron-builder",
    "lint": "pnpm i18n:compile && eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\" \"messages/**/*.json\" \"project.inlang/settings.json\"",
    "typecheck": "pnpm i18n:compile && tsc -b",
    "test": "pnpm i18n:compile && vitest run && cargo test --workspace",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-resizable-panels": "^4.12.2",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@inlang/paraglide-js": "^2.23.1",
    "@inlang/plugin-m-function-matcher": "2.2.6",
    "@inlang/plugin-message-format": "4.4.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vite-plugin-electron": "^1.1.1",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.rosettacue.desktop",
    "productName": "RosettaCue",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.video",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "extraResources": [
        {
          "from": "target/release/rosettacue-backend",
          "to": "backend/rosettacue-backend"
        },
        {
          "from": "resources/tools",
          "to": "tools"
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "extraResources": [
        {
          "from": "target/release/rosettacue-backend.exe",
          "to": "backend/rosettacue-backend.exe"
        },
        {
          "from": "resources/tools",
          "to": "tools"
        }
      ]
    },
    "linux": {
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "extraResources": [
        {
          "from": "target/release/rosettacue-backend",
          "to": "backend/rosettacue-backend"
        },
        {
          "from": "resources/tools",
          "to": "tools"
        }
      ]
    }
  }
}
